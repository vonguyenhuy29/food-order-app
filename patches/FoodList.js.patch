+      };
+    });
+    setMemberSearchText(realtimeName ? `${code} - ${realtimeName}` : code);
+  } else {
+    setOrderForm((prev) => ({
+      ...prev,
+      memberCard: '',
+      customerCode: '',
+      customerName: '',
+      level: '',
+    }));
+    setMemberSearchText('');
+  }
+
+  setFloorlensReturnTarget({
+    machineNumber: String(tableNo || ''),
+    area: String(area || ''),
+    tab: 'cart',
+  });
+
+  if (openMenu) {
+    setMode('menu');
+    if (compactShell) setMenuOpen(false);
+    setToast(`Đã chọn máy ${tableNo}`);
+  }
+};
+
