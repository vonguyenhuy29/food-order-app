--- /mnt/data/floorlens-ux-update-20260827/user/src/components/FloorLens.css	2026-08-27 11:33:35.820680890 +0000
+++ /mnt/data/floorlens-ux-fix-20260827-v2/user/src/components/FloorLens.css	2026-08-27 11:36:23.341308448 +0000
@@ -981,3 +981,445 @@
   .fl-profile-stats { grid-template-columns: 1fr 1fr; }
   .fl-order-card-head { grid-template-columns: minmax(0,1fr) 88px 18px; }
 }
+
+/* =====================================================================
+   FloorLens UX v3 - fixed workspace, old-avatar placement, multi-area,
+   header activity split, stronger order state and editable cart.
+   ===================================================================== */
+
+.fl-shell {
+  height: 100%;
+  min-height: 0;
+  max-height: 100%;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.fl-header {
+  flex: 0 0 auto;
+  display: grid;
+  grid-template-columns: auto minmax(360px, 1fr) auto;
+  align-items: center;
+  gap: 12px;
+  margin: -12px -16px 0;
+  padding: 9px 14px;
+  min-height: 62px;
+}
+.fl-title-block { align-self: center; }
+.fl-title-row h1 { font-size: 23px; }
+
+.fl-header-activity-board {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: minmax(0,1fr) minmax(0,1fr);
+  gap: 7px;
+}
+.fl-header-activity-card {
+  --activity-tone: #16a34a;
+  position: relative;
+  min-width: 0;
+  height: 44px;
+  display: grid;
+  grid-template-columns: auto minmax(0,1fr);
+  align-items: center;
+  gap: 7px;
+  padding: 4px 7px;
+  overflow: hidden;
+  background: #f8fafc;
+  border: 1px solid #e2e8f0;
+  border-left: 4px solid var(--activity-tone);
+  border-radius: 9px;
+}
+.fl-header-activity-card.is-leave { --activity-tone: #dc2626; }
+.fl-header-activity-label {
+  display: grid;
+  gap: 0;
+  min-width: 62px;
+}
+.fl-header-activity-label > span {
+  color: var(--activity-tone);
+  font-size: 9px;
+  font-weight: 1000;
+  letter-spacing: .08em;
+}
+.fl-header-activity-label > small {
+  color: #94a3b8;
+  font-size: 7.5px;
+  font-weight: 700;
+  white-space: nowrap;
+}
+.fl-header-activity-event {
+  position: relative;
+  min-width: 0;
+  height: 34px;
+  display: grid;
+  grid-template-columns: 32px minmax(0,1fr) 18px;
+  align-items: center;
+  gap: 6px;
+  padding: 0 4px 0 0;
+  overflow: hidden;
+  color: #0f172a;
+  background: #fff;
+  border: 0;
+  border-radius: 999px 8px 8px 999px;
+  cursor: pointer;
+  text-align: left;
+}
+.fl-header-activity-event > span { min-width: 0; }
+.fl-header-activity-event b {
+  display: block;
+  overflow: hidden;
+  font-size: 9.5px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.fl-header-activity-event small {
+  display: block;
+  overflow: hidden;
+  margin-top: 1px;
+  color: #64748b;
+  font-size: 8px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.fl-header-activity-event > strong { color: var(--activity-tone); font-size: 16px; }
+.fl-header-activity-empty {
+  overflow: hidden;
+  color: #94a3b8;
+  font-size: 8.5px;
+  font-weight: 800;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.fl-header-activity-close {
+  position: absolute;
+  top: 1px;
+  right: 1px;
+  z-index: 3;
+  width: 17px;
+  height: 17px;
+  border: 0;
+  background: transparent;
+  color: #94a3b8;
+  cursor: pointer;
+  font-size: 13px;
+}
+.fl-header-activity-progress {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: 2px;
+  background: var(--activity-tone);
+  transform-origin: left center;
+  animation: fl-toast-progress 5s linear forwards;
+}
+
+.fl-stats,
+.fl-toolbar,
+.fl-warning-stack { flex: 0 0 auto; }
+.fl-stats { padding: 7px 0; }
+.fl-stat-card { min-height: 64px; padding: 8px 11px; }
+.fl-stat-card strong { font-size: 22px; }
+.fl-stat-card.tone-not-ordered { --stat-tone: #dc2626; }
+
+.fl-workspace {
+  position: relative;
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow: hidden;
+}
+.fl-map-card {
+  height: 100%;
+  min-height: 0;
+  display: grid;
+  grid-template-rows: auto auto minmax(0,1fr);
+  overflow: hidden;
+}
+.fl-map-viewport {
+  height: auto !important;
+  min-height: 0 !important;
+  overflow: auto;
+  scrollbar-width: none;
+  -ms-overflow-style: none;
+}
+.fl-map-viewport::-webkit-scrollbar { width: 0; height: 0; display: none; }
+.fl-map-loading { min-height: 100%; }
+.fl-detail-panel {
+  top: 78px;
+  bottom: 8px;
+  max-height: none;
+}
+
+/* Multi-area checkbox dropdown */
+.fl-area-multi {
+  position: relative;
+  flex: 0 0 auto;
+  min-width: 150px;
+  z-index: 275;
+}
+.fl-area-multi-trigger {
+  width: 100%;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 0 10px;
+  color: #334155;
+  background: #fff;
+  border: 1px solid #cbd5e1;
+  border-radius: 9px;
+  cursor: pointer;
+  font-size: 11px;
+  font-weight: 800;
+}
+.fl-area-multi-trigger.is-open { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,.12); }
+.fl-area-multi-trigger span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.fl-area-multi-menu {
+  position: absolute;
+  top: calc(100% + 5px);
+  right: 0;
+  min-width: 210px;
+  max-height: 310px;
+  overflow-y: auto;
+  padding: 6px;
+  background: rgba(255,255,255,.995);
+  border: 1px solid #dbe3ee;
+  border-radius: 10px;
+  box-shadow: 0 16px 35px rgba(15,23,42,.2);
+}
+.fl-area-check {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 32px;
+  padding: 5px 7px;
+  border-radius: 7px;
+  color: #334155;
+  cursor: pointer;
+  font-size: 10px;
+  font-weight: 800;
+}
+.fl-area-check:hover { background: #f1f5f9; }
+.fl-area-check.is-all { border-bottom: 1px solid #eef2f7; margin-bottom: 3px; }
+.fl-area-check input { width: 15px; height: 15px; accent-color: #0f766e; }
+
+/* Order status must be obvious on the machine itself. */
+.fl-map-machine { --status-width: 0px; }
+.fl-map-machine-body {
+  box-shadow: 0 0 0 var(--status-width) var(--status-ring), 0 1px 2px rgba(15,23,42,.18);
+}
+.fl-map-machine.tone-idle { --status-width: 0px; --status-ring: transparent; }
+.fl-map-machine.tone-ordered { --status-width: 4px; --status-ring: #047857; }
+.fl-map-machine.tone-not-ordered { --status-width: 4px; --status-ring: #dc2626; }
+.fl-map-machine.tone-unknown { --status-width: 3px; --status-ring: #7c3aed; }
+.fl-map-machine.tone-uncertain { --status-width: 2px; --status-ring: #ef4444; }
+.fl-map-machine:hover .fl-map-machine-body,
+.fl-map-machine.is-selected .fl-map-machine-body {
+  box-shadow:
+    0 0 0 var(--status-width) var(--status-ring),
+    0 0 0 calc(var(--status-width) + 3px) #0ea5e9,
+    0 5px 16px rgba(14,165,233,.25);
+}
+.fl-map-machine.is-table-selected .fl-map-machine-body {
+  outline: 2px solid #facc15;
+  outline-offset: 6px;
+}
+.fl-fallback-machine.tone-ordered { border: 4px solid #047857; }
+.fl-fallback-machine.tone-not-ordered { border: 4px solid #dc2626; }
+.fl-legend i.not-ordered { background: #dc2626; }
+.fl-order-summary.tone-not-ordered { --order-border: #fca5a5; --order-bg: #fef2f2; }
+.fl-order-summary.tone-not-ordered .fl-order-summary-title > span { color: #dc2626; }
+.fl-history-order.tone-not-ordered { color: #991b1b; background: #fee2e2; }
+
+/* Avatar behaves like the old FloorLens: old screen-side placement, green live ring,
+   no order-status dot. Order state is shown by the machine border instead. */
+.fl-map-avatar-slot { z-index: 35; }
+.fl-customer-avatar { object-position: center center; }
+.fl-customer-avatar.fl-avatar-live {
+  outline: 2px solid #16a34a !important;
+  outline-offset: 0;
+}
+.fl-avatar-click-target.is-unknown .fl-customer-avatar-fallback,
+.fl-map-avatar-slot .fl-customer-avatar-fallback {
+  color: #111827;
+  background: #facc15;
+  outline: 2px solid #ca8a04;
+}
+.fl-avatar-order-dot { display: none !important; }
+
+/* Full cart controls inside the machine drawer. */
+.fl-cart-toolbar {
+  display: grid;
+  grid-template-columns: repeat(3,minmax(0,1fr));
+  gap: 6px;
+  margin: 9px 0;
+}
+.fl-cart-toolbar button {
+  min-height: 32px;
+  padding: 5px 7px;
+  color: #334155;
+  background: #fff;
+  border: 1px solid #cbd5e1;
+  border-radius: 8px;
+  cursor: pointer;
+  font-size: 9px;
+  font-weight: 900;
+}
+.fl-cart-toolbar button.primary { color: #fff; background: #0f766e; border-color: #0f766e; }
+.fl-cart-toolbar button.danger { color: #b91c1c; border-color: #fecaca; background: #fff7f7; }
+.fl-cart-row-editable {
+  display: grid;
+  grid-template-columns: minmax(0,1fr) auto;
+  gap: 7px;
+  align-items: center;
+}
+.fl-cart-item-main {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: 42px minmax(0,1fr);
+  align-items: center;
+  gap: 8px;
+}
+.fl-cart-item-main img,
+.fl-cart-item-icon {
+  width: 42px;
+  height: 42px;
+  border-radius: 7px;
+  object-fit: cover;
+  display: grid;
+  place-items: center;
+  color: #7c3aed;
+  background: #f5f3ff;
+  border: 1px solid #ddd6fe;
+  font-size: 8px;
+  font-weight: 1000;
+}
+.fl-cart-item-main strong { display: block; overflow: hidden; color: #0f172a; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
+.fl-cart-item-main small { display: block; margin-top: 2px; color: #64748b; font-size: 8px; }
+.fl-cart-qty-controls { display: flex; align-items: center; gap: 4px; }
+.fl-cart-qty-controls button {
+  min-width: 27px;
+  height: 27px;
+  border: 1px solid #cbd5e1;
+  border-radius: 7px;
+  background: #fff;
+  cursor: pointer;
+  font-weight: 900;
+}
+.fl-cart-qty-controls b { min-width: 22px; text-align: center; font-size: 10px; }
+.fl-cart-qty-controls .remove { color: #b91c1c; font-size: 8px; padding: 0 6px; }
+.fl-cart-note-input,
+.fl-cart-name-input {
+  width: 100%;
+  box-sizing: border-box;
+  min-height: 30px;
+  padding: 5px 7px;
+  color: #334155;
+  background: #fff;
+  border: 1px solid #dbe3ee;
+  border-radius: 7px;
+  outline: none;
+  font-size: 9px;
+}
+.fl-cart-note-input { grid-column: 1 / -1; }
+.fl-cart-note-input:focus,
+.fl-cart-name-input:focus { border-color: #38bdf8; box-shadow: 0 0 0 2px rgba(56,189,248,.12); }
+.fl-cart-checkout {
+  width: 100%;
+  min-height: 36px;
+  margin-top: 9px;
+  color: #fff;
+  background: #16a34a;
+  border: 0;
+  border-radius: 9px;
+  cursor: pointer;
+  font-size: 10px;
+  font-weight: 1000;
+}
+
+/* Old floating toast stack is intentionally not used in v3. */
+.fl-alert-stack { display: none !important; }
+
+@media (max-width: 1180px) {
+  .fl-header { grid-template-columns: auto minmax(280px,1fr) auto; }
+  .fl-header-activity-label > small { display: none; }
+}
+
+@media (max-width: 1024px) {
+  .fl-header {
+    margin: 0;
+    grid-template-columns: auto minmax(0,1fr) auto;
+    padding: 7px 9px;
+  }
+  .fl-header-activity-board { min-width: 0; }
+  .fl-header-activity-label { min-width: 36px; }
+  .fl-header-activity-event { grid-template-columns: 28px minmax(0,1fr) 14px; }
+  .fl-header-activity-event .fl-customer-avatar { width: 28px !important; height: 28px !important; }
+  .fl-detail-panel { top: 76px; }
+}
+
+@media (max-width: 760px) {
+  .fl-shell { height: 100%; }
+  .fl-header {
+    grid-template-columns: minmax(0,1fr) auto;
+    grid-template-areas:
+      "title actions"
+      "activity activity";
+    gap: 6px;
+    min-height: 0;
+  }
+  .fl-title-block { grid-area: title; }
+  .fl-header-actions { grid-area: actions; }
+  .fl-header-activity-board { grid-area: activity; grid-template-columns: 1fr 1fr; }
+  .fl-header-activity-card { height: 39px; }
+  .fl-header-activity-label { min-width: 28px; }
+  .fl-header-activity-event { height: 30px; }
+
+  /* On phone/tablet the counters become one horizontal row so the map keeps height. */
+  .fl-stats {
+    display: flex;
+    overflow-x: auto;
+    gap: 6px;
+    padding: 6px 0;
+    scrollbar-width: none;
+  }
+  .fl-stats::-webkit-scrollbar { display: none; }
+  .fl-stat-card { flex: 0 0 122px; min-height: 57px; padding: 7px 9px; }
+  .fl-stat-card strong { font-size: 19px; }
+  .fl-stat-card > span { font-size: 10px; }
+  .fl-stat-card small { font-size: 8px; }
+
+  .fl-toolbar { gap: 6px; padding-bottom: 6px; }
+  .fl-search-wrap { flex-basis: 100%; }
+  .fl-floor-segment { flex: 1 1 45%; width: auto; }
+  .fl-area-multi { flex: 1 1 45%; min-width: 0; }
+  .fl-toolbar > select { flex: 1 1 45%; min-width: 0; }
+  .fl-area-multi-menu { left: 0; right: auto; min-width: min(270px, calc(100vw - 24px)); }
+  .fl-map-card { height: 100%; }
+  .fl-map-topbar { min-height: 40px; }
+  .fl-map-controls { width: auto; margin-left: auto; }
+  .fl-map-mouse-hint { display: none; }
+  .fl-map-viewport { height: auto !important; min-height: 0 !important; }
+
+  .fl-detail-panel {
+    top: auto !important;
+    max-height: 72vh;
+  }
+  .fl-cart-toolbar { grid-template-columns: 1fr 1fr; }
+  .fl-cart-toolbar button.primary { grid-column: 1 / -1; }
+  .fl-cart-row-editable { grid-template-columns: 1fr; }
+  .fl-cart-qty-controls { justify-content: flex-end; }
+}
+
+@media (max-width: 480px) {
+  .fl-title-row h1 { font-size: 19px; }
+  .fl-header-activity-label { display: none; }
+  .fl-header-activity-card { grid-template-columns: 1fr; padding: 3px 5px; }
+  .fl-header-activity-event { width: 100%; }
+  .fl-live { display: none; }
+  .fl-area-multi { flex-basis: 100%; }
+  .fl-toolbar > select { flex-basis: 100%; }
+}
