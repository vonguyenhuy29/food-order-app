+// Các machine mà một member đã chơi trong Gaming Date hiện tại.
+// Đọc từ RAM của FloorLens realtime, không quét lại upstream.
+app.get('/api/user/floorlens/customer/:memberCode/machines', (req, res) => {
+  try {
+    const code = String(req.params.memberCode || '').replace(/\s+/g, '').trim();
+    if (!code) return res.status(400).json({ error: 'memberCode required' });
+
+    const limit = Math.min(200, Math.max(1, Number(req.query?.limit || 50)));
+    const rows = typeof floorlensService.getCustomerMachineHistory === 'function'
+      ? floorlensService.getCustomerMachineHistory(code, limit)
+      : [];
+
+    res.setHeader('Cache-Control', 'no-store');
+    res.json({
+      memberCode: code,
+      gamingDate: floorlensService.getSnapshot()?.gamingDate || null,
+      rows,
+    });
+  } catch (error) {
+    res.status(500).json({ error: error?.message || 'Cannot load customer machine history' });
+  }
+});
+
+// Orders của đúng machine/table trong business day hiện tại.
+// Dùng để FloorLens xem ngay khách đã gọi món gì mà không chuyển sang trang Orders.
+app.get('/api/user/floorlens/orders/:machineNumber', (req, res) => {
+  try {
+    const machineNumber = String(req.params.machineNumber || '').trim();
+    if (!machineNumber) return res.status(400).json({ error: 'machineNumber required' });
+
+    const snapshotNow = floorlensService.getSnapshot();
+    const machine = (Array.isArray(snapshotNow?.machines) ? snapshotNow.machines : [])
+      .find((row) => String(row?.machineNumber || '') === machineNumber) || null;
+    const area = String(req.query?.area || machine?.area || '').trim();
+    if (!area) return res.status(404).json({ error: 'Machine area not found' });
+
+    const { from, to } = floorlensBusinessWindow();
+    const limit = Math.min(100, Math.max(1, Number(req.query?.limit || 30)));
+    const includeCancelled = ['1', 'true', 'yes'].includes(String(req.query?.includeCancelled || '').toLowerCase());
+
+    const rows = typeof sqliteStore.queryOrders === 'function'
+      ? sqliteStore.queryOrders({
+          area,
+          tableNo: machineNumber,
+          includeClosed: true,
+          from: from.toISOString(),
+          to: to.toISOString(),
+          limit: Math.max(limit * 2, limit),
+        })
+      : (orders || []).filter((order) =>
+          String(order?.area || '') === area &&
+          String(order?.tableNo || '') === machineNumber
+        );
+
+    const filtered = rows
+      .filter((order) => includeCancelled || String(order?.status || '').toUpperCase() !== 'CANCELLED')
+      .sort((a, b) => new Date(b?.createdAt || 0) - new Date(a?.createdAt || 0))
+      .slice(0, limit)
+      .map((order) => {
+        const items = Array.isArray(order?.items) ? order.items : [];
+        const total = items.reduce((sum, item) => {
+          const qty = Number(item?.qty ?? item?.quantity ?? 0) || 0;
+          const explicit = Number(item?.lineTotal ?? item?.total ?? item?.amount);
+          if (Number.isFinite(explicit)) return sum + explicit;
+          return sum + (Number(item?.price ?? item?.unitPrice ?? 0) || 0) * qty;
+        }, 0);
+        return { ...order, items, total };
+      });
+
+    res.setHeader('Cache-Control', 'no-store');
+    res.json({
+      machineNumber,
+      area,
+      from: from.toISOString(),
+      to: to.toISOString(),
+      count: filtered.length,
+      rows: filtered,
+    });
+  } catch (error) {
+    console.error('[FloorLens] machine orders error:', error?.message || error);
+    res.status(500).json({ error: error?.message || 'Cannot load machine orders' });
+  }
+});
